# Copy to .env for local runs. Never commit .env.

# Required. Long random string. Anyone with it can use your assistant.
# Generate one with: openssl rand -hex 24
AGENT_TOKEN=change-me-to-a-long-random-string

# Required. Claude API key from https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-sonnet-5-5.
ANTHROPIC_MODEL=claude-sonnet-5-5

# Approval storage. With both set, approvals persist in Supabase.
# The SECRET (service role) key is required; the publishable key cannot write
# because the approvals table has RLS enabled with no policies.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Leave blank to run that connector in mock mode.
GHL_API_KEY=
GMAIL_REFRESH_TOKEN=
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_STORE_DOMAIN=
SOCIAL_API_KEY=

PORT=3000
APPROVALS_FILE=./data/approvals.json
