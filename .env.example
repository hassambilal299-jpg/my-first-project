# Copy to .env and fill in. Every value below is read at runtime.
#
# The three secrets must be DIFFERENT random values, and none of them may be
# left as "change-me" — the app refuses to start a session or accept an admin
# request with a placeholder, on purpose.
#
#   openssl rand -base64 32

# --- Database. Free at neon.tech ---
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# --- Session signing ---
AUTH_SECRET="change-me"

# --- Protects the scheduled-check endpoint (/api/cron/check).
#     This is the one you paste into a cron configuration, so it is the one
#     most likely to end up in a log. It grants nothing but running a check. ---
CRON_SECRET="change-me"

# --- Protects the endpoints that CHANGE data: /api/admin/plan, which grants
#     paid plans, and /api/admin/migrate. Keep it separate from CRON_SECRET so
#     the value in your cron configuration can't hand out Agency accounts.
#     Falls back to CRON_SECRET if unset. Header only, POST only. ---
ADMIN_SECRET="change-me"

# --- Your public address, used for absolute links in the sitemap, social
#     previews and emails. On Vercel this is detected automatically; set it
#     once you have a custom domain. ---
# SITE_URL="https://sitegrade.app"

# --- Email alerts (optional). Without a key, alerts still show in the
#     dashboard, they just aren't emailed. Free key at resend.com ---
RESEND_API_KEY=""
ALERT_FROM_EMAIL="alerts@yourdomain.com"

# --- Local development only. Lifts the guard that stops the auditor being
#     pointed at private networks. NEVER set this in production. ---
# ALLOW_PRIVATE_HOSTS="1"
