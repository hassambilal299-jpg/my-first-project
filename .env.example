# Copy to .env for local runs. Never commit .env.

# Required. The password you type into the app.
# Generate one with: openssl rand -hex 24
AGENT_TOKEN=change-me-to-a-long-random-string

# Optional. Claude API key from https://console.anthropic.com (needs prepaid credit).
# Without it, command mode still works - say "help" in the app. Only free-form
# conversation needs this.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-haiku-5-5 ($0.10/$0.50 per million tokens), the
# cheapest model and ample for chat. claude-opus-5-5 is ~40x the price.
ANTHROPIC_MODEL=claude-haiku-5-5

# Encrypts client connector credentials before they are stored.
# Generate with: openssl rand -hex 32   (must be 64 hex characters)
# Without this, storing client credentials is refused rather than done in plaintext.
CREDENTIALS_KEY=

# Persistence. With both set, data lives in Supabase via the Edge Function.
# Without them, storage falls back to a local JSON file (fine for development).
SUPABASE_STORE_URL=
SUPABASE_API_KEY=

# Optional second lock on the Edge Function. Set the value in the Supabase
# dashboard (Edge Functions -> Secrets) as JARVIS_STORE_TOKEN, and mirror it here.
JARVIS_STORE_TOKEN=

# Set equal to AGENT_TOKEN so the scheduled sweep can authenticate.
CRON_SECRET=

# Voice. Without a key the browser's built-in voice is used: free, but robotic.
# With one, replies are spoken by ElevenLabs (billed per character, so replies
# are capped at 600 characters server-side). The key stays on the server.
# ELEVENLABS_VOICE_ID is optional - the first voice on the account is used.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5

# Default connector credentials for your own accounts.
# Leave blank to run that connector in mock mode.
GHL_API_KEY=
GMAIL_REFRESH_TOKEN=
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_STORE_DOMAIN=
SOCIAL_API_KEY=

PORT=3000
STORE_FILE=./data/store.json
