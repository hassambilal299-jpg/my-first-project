# --- Database. Free at neon.tech ---
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# --- Session signing. openssl rand -base64 32 ---
AUTH_SECRET="change-me"

# --- Protects the scheduled-check endpoint. openssl rand -base64 32 ---
CRON_SECRET="change-me"

# --- Email alerts (optional). Without a key, alerts still show in the
#     dashboard, they just aren't emailed. Free key at resend.com ---
RESEND_API_KEY=""
ALERT_FROM_EMAIL="alerts@yourdomain.com"

# --- Local development only. Never set in production ---
# ALLOW_PRIVATE_HOSTS="1"
